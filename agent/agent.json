{
  "schema_version": "2026-05-27",
  "id": "wechat-social-assistant",
  "name": "WeChat Social Assistant",
  "version": "0.7.0",
  "description": "Local-first relationship memory and follow-up assistant for visible WeChat conversations.",
  "ecosystems": [
    "hermes",
    "openclaw-non-plugin",
    "codex",
    "claude-code"
  ],
  "cli": {
    "entrypoint": "python3 -m wsa.cli",
    "console_script": "wsa",
    "doctor": "agent/hermes/wechat-social-assistant/scripts/doctor.py",
    "runner": "agent/hermes/wechat-social-assistant/scripts/wsa_run.py"
  },
  "mcp": {
    "command": "python3 -m wsa.mcp_server",
    "console_script": "wsa-mcp",
    "transport": "stdio",
    "read_only": false,
    "write_tools_require_confirmation": true,
    "tools": [
      "get_status",
      "search_contacts",
      "get_contact_brief",
      "get_next_followup",
      "get_daily_report",
      "get_weekly_report",
      "get_relationship_quality",
      "list_relationship_candidates",
      "confirm_relationship_candidate",
      "list_feedback",
      "record_feedback",
      "list_recent_captures"
    ],
    "resources": [
      "wsa://status",
      "wsa://contacts",
      "wsa://daily-report",
      "wsa://weekly-report",
      "wsa://relationship-quality",
      "wsa://relationship-candidates"
    ],
    "prompts": [
      "daily-relationship-review",
      "weekly-relationship-review",
      "contact-followup",
      "relationship-candidate-review",
      "safe-capture-review"
    ],
    "write_policy": "Mutating MCP tools require explicit confirmation: record_feedback needs confirmation_text='record local feedback'; confirm_relationship_candidate needs confirmation_text='confirm relationship candidate'."
  },
  "capabilities": [
    "local_status",
    "contact_search",
    "contact_brief",
    "relationship_quality",
    "relationship_candidate_discovery",
    "feedback_loop",
    "followup_suggestions",
    "daily_analysis",
    "weekly_analysis",
    "mcp_read_only_interface",
    "obsidian_export",
    "obsidian_import",
    "manual_enrichment",
    "ocr_import",
    "explicit_watch_mode"
  ],
  "commands": [
    {
      "name": "status",
      "mode": "read",
      "example": "python3 -m wsa.cli status"
    },
    {
      "name": "contacts",
      "mode": "read",
      "example": "python3 -m wsa.cli contacts --query NAME"
    },
    {
      "name": "brief",
      "mode": "read",
      "example": "python3 -m wsa.cli brief NAME"
    },
    {
      "name": "quality",
      "mode": "read",
      "example": "python3 -m wsa.cli quality --contact NAME"
    },
    {
      "name": "candidates",
      "mode": "read",
      "example": "python3 -m wsa.cli candidates --min-confidence 45"
    },
    {
      "name": "candidate-confirm",
      "mode": "write-database",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli candidate-confirm NAME --source-chat GROUP --yes"
    },
    {
      "name": "weekly-report",
      "mode": "read",
      "example": "python3 -m wsa.cli weekly-report --date 2026-05-27"
    },
    {
      "name": "feedback-list",
      "mode": "read",
      "example": "python3 -m wsa.cli feedback-list --contact NAME"
    },
    {
      "name": "feedback",
      "mode": "write-database",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli feedback NAME too_pushy --note 'draft was too direct'"
    },
    {
      "name": "next",
      "mode": "read",
      "example": "python3 -m wsa.cli next --contact NAME"
    },
    {
      "name": "suggest",
      "mode": "read",
      "example": "python3 -m wsa.cli suggest --contact NAME"
    },
    {
      "name": "analyze",
      "mode": "write-reports",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli analyze"
    },
    {
      "name": "export-obsidian",
      "mode": "write-files",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli export-obsidian --vault \"$HOME/Documents/Obsidian Vault\""
    },
    {
      "name": "import-obsidian",
      "mode": "write-database",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli import-obsidian --vault \"$HOME/Documents/Obsidian Vault\" --yes"
    },
    {
      "name": "import-image",
      "mode": "write-database",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli import-image ./screenshot.png --contact NAME"
    },
    {
      "name": "watch",
      "mode": "capture",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli watch --interval 60"
    },
    {
      "name": "stop-watch",
      "mode": "process-control",
      "requires_confirmation": true,
      "example": "python3 -m wsa.cli stop-watch"
    }
  ],
  "data_policy": {
    "storage": "local-first",
    "database": "data/social.db by default",
    "manual_enrichment": "contact_enrichments rows inside data/social.db",
    "screenshots": "data/captures by default",
    "reads_wechat_database": false,
    "sends_messages": false,
    "requires_user_confirmation_for_writes": true,
    "auditability": "Commands print affected paths and process state; generated files stay local unless the user publishes them."
  },
  "install": {
    "from_repo": "python3 -m pip install git+https://github.com/harrylabsj/wechat-social-assistant.git",
    "from_checkout": "python3 -m pip install -e .",
    "hermes_skill": "hermes skills install https://raw.githubusercontent.com/harrylabsj/wechat-social-assistant/main/agent/hermes/wechat-social-assistant/SKILL.md --yes"
  }
}
